PORT=8080
DATABASE_URL=postgres://task_user:task_password@localhost:5432/task_manager?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
LOG_LEVEL=info
READINESS_TIMEOUT=2s
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=30m
EMAIL_VERIFICATION_TTL=24h
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=1m
RATE_LIMIT_FAIL_OPEN=true
EXPOSE_AUTH_TOKENS=false
SHUTDOWN_TIMEOUT=10s
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_TIME=5m
DB_CONN_MAX_LIFETIME=30m
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_TIMEOUT=4s
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
IDEMPOTENCY_TTL=24h
WEBHOOK_ALLOW_INSECURE_HTTP=false
WORKER_POLL_INTERVAL=2s
WORKER_BATCH_SIZE=50
WEBHOOK_TIMEOUT=10s
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:8080
WEBAUTHN_RP_DISPLAY_NAME=Simple Task Manager

# Optional Phase 29 generic billing-provider webhook HMAC secret (minimum 32 chars when enabled).
BILLING_WEBHOOK_SECRET=
