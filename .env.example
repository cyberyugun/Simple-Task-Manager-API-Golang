PORT=8080
DATABASE_URL=postgres://task_user:task_password@localhost:5432/task_manager?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
LOG_LEVEL=info
READINESS_TIMEOUT=2s
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=30m
EMAIL_VERIFICATION_TTL=24h
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=1m
RATE_LIMIT_FAIL_OPEN=true
EXPOSE_AUTH_TOKENS=false
SHUTDOWN_TIMEOUT=10s
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_TIME=5m
DB_CONN_MAX_LIFETIME=30m
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_TIMEOUT=4s
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
IDEMPOTENCY_TTL=24h
WEBHOOK_ALLOW_INSECURE_HTTP=false
WORKER_POLL_INTERVAL=2s
WORKER_BATCH_SIZE=50
WEBHOOK_TIMEOUT=10s
NOTIFICATION_POLL_INTERVAL=2s
NOTIFICATION_SCHEDULE_POLL_INTERVAL=1m
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_HTTP_TIMEOUT=10s
NOTIFICATION_REMINDER_HORIZON=24h
NOTIFICATION_EMAIL_PROVIDER_URL=
NOTIFICATION_PUSH_PROVIDER_URL=
NOTIFICATION_PROVIDER_TOKEN=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:8080
WEBAUTHN_RP_DISPLAY_NAME=Simple Task Manager

# Optional Phase 29 generic billing-provider webhook HMAC secret (minimum 32 chars when enabled).
BILLING_WEBHOOK_SECRET=

ATTACHMENT_STORAGE_PROVIDER=s3_compatible
ATTACHMENT_STORAGE_BUCKET=task-attachments
ATTACHMENT_STORAGE_BASE_URL=https://storage.example.com
ATTACHMENT_STORAGE_NATIVE=false
ATTACHMENT_ENCRYPTION=AES256
ATTACHMENT_ENCRYPTION_KEY_ID=
ATTACHMENT_DEDUPLICATE=true
ATTACHMENT_SCAN_POLL_INTERVAL=5s
ATTACHMENT_RETENTION_POLL_INTERVAL=1h
ATTACHMENT_BATCH_SIZE=50

# Native S3 / S3-compatible storage.
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_STS_ENDPOINT=
ATTACHMENT_S3_ROLE_ARN=
ATTACHMENT_S3_WEB_IDENTITY_TOKEN_FILE=
ATTACHMENT_S3_ROLE_SESSION_NAME=
ATTACHMENT_S3_FORCE_PATH_STYLE=
ATTACHMENT_S3_TIMEOUT=15s

# Native Azure Blob storage.
ATTACHMENT_AZURE_STORAGE_ACCOUNT=
ATTACHMENT_AZURE_STORAGE_ACCOUNT_KEY=
ATTACHMENT_AZURE_BLOB_ENDPOINT=
ATTACHMENT_AZURE_ACCESS_TOKEN=
ATTACHMENT_AZURE_USE_MANAGED_IDENTITY=false
ATTACHMENT_AZURE_MANAGED_IDENTITY_ENDPOINT=
ATTACHMENT_AZURE_TIMEOUT=15s

# Native GCS storage.
ATTACHMENT_GCS_ENDPOINT=
ATTACHMENT_GCS_SERVICE_ACCOUNT_EMAIL=
ATTACHMENT_GCS_IAM_CREDENTIALS_ENDPOINT=
ATTACHMENT_GCS_ACCESS_TOKEN=
ATTACHMENT_GCS_USE_METADATA=true
ATTACHMENT_GCS_METADATA_ENDPOINT=
ATTACHMENT_GCS_TIMEOUT=15s

# Remote attachment malware scanner.
ATTACHMENT_SCANNER_URL=
ATTACHMENT_SCANNER_BEARER_TOKEN=
ATTACHMENT_SCANNER_SIGNING_SECRET=
ATTACHMENT_SCANNER_REQUIRED=false

# Opt-in live provider contracts. Normal unit/CI runs leave these disabled.
LIVE_PROVIDER_CONTRACTS=false
LIVE_PROVIDER_CONTRACT_TARGET=
LIVE_PROVIDER_STORAGE_TARGET=
LIVE_PROVIDER_ALLOW_INSECURE=false
REPORT_SCHEDULE_POLL_INTERVAL=1m
REPORT_SCHEDULE_BATCH_SIZE=50

CONNECTOR_OAUTH_REFRESH_POLL_INTERVAL=1m
CONNECTOR_OAUTH_REFRESH_BATCH_SIZE=50

# HashiCorp Vault KV v2 connector secret backend.
CONNECTOR_VAULT_ADDR=
CONNECTOR_VAULT_TOKEN=
CONNECTOR_VAULT_TOKEN_FILE=
CONNECTOR_VAULT_NAMESPACE=
CONNECTOR_VAULT_KV_MOUNT=secret
CONNECTOR_VAULT_PREFIX=simple-task-manager/connectors
CONNECTOR_VAULT_TIMEOUT=10s

# AWS Secrets Manager connector secret backend.
CONNECTOR_AWS_SECRETS_MANAGER_ENABLED=false
CONNECTOR_AWS_REGION=
CONNECTOR_AWS_SECRET_PREFIX=simple-task-manager/connectors
CONNECTOR_AWS_KMS_KEY_ID=
CONNECTOR_AWS_SECRETS_ENDPOINT=
CONNECTOR_AWS_STS_ENDPOINT=
CONNECTOR_AWS_RECOVERY_WINDOW_DAYS=7
CONNECTOR_AWS_TIMEOUT=10s

# Azure Key Vault connector secret backend.
CONNECTOR_AZURE_KEY_VAULT_ENABLED=false
CONNECTOR_AZURE_KEY_VAULT_URL=
CONNECTOR_AZURE_SECRET_PREFIX=stm-connectors
CONNECTOR_AZURE_ACCESS_TOKEN=
CONNECTOR_AZURE_USE_MANAGED_IDENTITY=false
CONNECTOR_AZURE_MANAGED_IDENTITY_ENDPOINT=
CONNECTOR_AZURE_CMK_KEY_ID=
CONNECTOR_AZURE_TIMEOUT=10s

# GCP Secret Manager connector secret backend.
CONNECTOR_GCP_SECRET_MANAGER_ENABLED=false
CONNECTOR_GCP_PROJECT_ID=
CONNECTOR_GCP_SECRET_PREFIX=stm-connectors
CONNECTOR_GCP_CMEK_KEY_NAME=
CONNECTOR_GCP_SECRET_MANAGER_ENDPOINT=
CONNECTOR_GCP_ACCESS_TOKEN=
CONNECTOR_GCP_USE_METADATA=true
CONNECTOR_GCP_METADATA_ENDPOINT=
CONNECTOR_GCP_TIMEOUT=10s

EVENT_FABRIC_POLL_INTERVAL=2s
EVENT_FABRIC_RETENTION_POLL_INTERVAL=1h
EVENT_FABRIC_BATCH_SIZE=50

# Optional native Snowflake SQL API warehouse delivery.
DATA_PLATFORM_SNOWFLAKE_NATIVE=false
DATA_PLATFORM_SNOWFLAKE_ENDPOINT=
DATA_PLATFORM_SNOWFLAKE_TOKEN=
DATA_PLATFORM_SNOWFLAKE_TOKEN_TYPE=OAUTH
DATA_PLATFORM_SNOWFLAKE_TIMEOUT=30s
DATA_PLATFORM_SNOWFLAKE_RETRY_ATTEMPTS=3
DATA_PLATFORM_SNOWFLAKE_RETRY_BACKOFF=300ms
DATA_PLATFORM_SNOWFLAKE_POLL_INTERVAL=250ms

# Optional native Amazon Redshift Data API warehouse delivery.
DATA_PLATFORM_REDSHIFT_NATIVE=false
DATA_PLATFORM_REDSHIFT_REGION=
DATA_PLATFORM_REDSHIFT_ENDPOINT=
DATA_PLATFORM_REDSHIFT_STS_ENDPOINT=
DATA_PLATFORM_REDSHIFT_TIMEOUT=30s
DATA_PLATFORM_REDSHIFT_RETRY_ATTEMPTS=3
DATA_PLATFORM_REDSHIFT_RETRY_BACKOFF=300ms
DATA_PLATFORM_REDSHIFT_POLL_INTERVAL=300ms

# Optional native Databricks SQL Statement Execution warehouse delivery.
DATA_PLATFORM_DATABRICKS_NATIVE=false
DATA_PLATFORM_DATABRICKS_ENDPOINT=
DATA_PLATFORM_DATABRICKS_TOKEN=
DATA_PLATFORM_DATABRICKS_TIMEOUT=30s
DATA_PLATFORM_DATABRICKS_RETRY_ATTEMPTS=3
DATA_PLATFORM_DATABRICKS_RETRY_BACKOFF=300ms
DATA_PLATFORM_DATABRICKS_POLL_INTERVAL=300ms

# Optional production external AI gateway. AI is still organization-policy opt-in.
AI_REMOTE_PROVIDER_ENABLED=false
AI_REMOTE_PROVIDER_ENDPOINT=
AI_REMOTE_PROVIDER_TOKEN=
AI_REMOTE_PROVIDER_MODEL=
AI_REMOTE_PROVIDER_SUPPORTED_CLASSIFICATIONS=public,internal
AI_REMOTE_PROVIDER_TIMEOUT=30s
AI_REMOTE_PROVIDER_RETRY_ATTEMPTS=3
AI_REMOTE_PROVIDER_RETRY_BACKOFF=300ms
AI_REMOTE_PROVIDER_MAX_REQUEST_BYTES=262144
AI_REMOTE_PROVIDER_MAX_RESPONSE_BYTES=1048576
AI_REMOTE_PROVIDER_MAX_OUTPUT_UNITS=2048
AI_REMOTE_PROVIDER_INPUT_COST_CENTS_PER_1K_UNITS=1
AI_REMOTE_PROVIDER_OUTPUT_COST_CENTS_PER_1K_UNITS=2

# Optional external multi-region deployment planning handoff.
# The API only submits plan_only requests; live apply/failover stays externally gated.
REGION_AUTOMATION_ENABLED=false
REGION_AUTOMATION_ENDPOINT=
REGION_AUTOMATION_SIGNING_SECRET=
REGION_AUTOMATION_BEARER_TOKEN=
REGION_AUTOMATION_TIMEOUT=20s
REGION_AUTOMATION_RETRY_ATTEMPTS=3
REGION_AUTOMATION_RETRY_BACKOFF=300ms
REGION_AUTOMATION_MAX_RESPONSE_BYTES=262144
