PORT=8080
DATABASE_URL=postgres://task_user:task_password@localhost:5432/task_manager?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
LOG_LEVEL=info
READINESS_TIMEOUT=2s
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=30m
EMAIL_VERIFICATION_TTL=24h
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=1m
RATE_LIMIT_FAIL_OPEN=true
EXPOSE_AUTH_TOKENS=false
SHUTDOWN_TIMEOUT=10s
